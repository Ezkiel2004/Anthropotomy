{
  "name": "anthropotomy-landing-src",
  "private": true,
  "description": "Build tooling for the public pages (index.html, login.html). Not needed to run the site.",
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/public.css -o ../assets/css/public.css --minify",
    "watch:css": "tailwindcss -i ./src/public.css -o ../assets/css/public.css --watch",
    "build:assets": "node scripts/build-assets.mjs",
    "build:og": "node scripts/build-og.mjs",
    "check:contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
