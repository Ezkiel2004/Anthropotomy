# Keep scripts, tests, private files and dot-folders (.git, .runtime) off the web.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(database|deploy|tests|storage|tools)(/|$) - [R=404,L]
  RewriteRule (^|/)\. - [R=404,L]
</IfModule>
# pdf.js ships as .mjs modules; a host that does not know the extension would not serve them as JavaScript.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
# Cache static files in the visitor's browser: repeat visits (and the 2-8 MB layer files) cost no transfer.
# Versioned URLs (?v=...) never change in place, so they cache for a month; fonts, wasm and models by path too.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|wasm|glb)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{QUERY_STRING} =~ /(^|&)v=/ && %{REQUEST_URI} =~ m#/(assets|system_model)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <FilesMatch "\.(webp|avif|png|jpe?g|svg)$">
    Header setIfEmpty Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
# Compress text when the host has mod_deflate on (Cloudflare already does this for the tunnel).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
